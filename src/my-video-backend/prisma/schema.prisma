// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  isActive  Boolean
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  type      UserTypes @default(USER)

  favorites  Favorite[]
  watchLater WatchLater[]
  watched    Watched[]
}

enum UserTypes {
  ADMIN
  USER
}

model Midia {
  id          String   @id @default(uuid())
  title       String
  titleSlug   String   @unique
  thumb       String
  description String
  debutYear   Int
  duration    Int
  categories  String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Filme       Filme?
  Serie       Serie?

  WatchLater WatchLater[]
  Watched    Watched[]
  type       MidiaTypes
  Favorite   Favorite[]
}

enum MidiaTypes {
  FILME
  SERIE
}

model Filme {
  id       String @id @default(uuid())
  midia    Midia  @relation(fields: [id], references: [id], onDelete: Cascade)
  director String
}

model Serie {
  id               String @id @default(uuid())
  midia            Midia  @relation(fields: [id], references: [id], onDelete: Cascade)
  seasons          Int
  numberOfEpisodes Int

  episodes SerieEpisode[]
}

model SerieEpisode {
  id            String @id @default(uuid())
  season        Int
  episodeNumber Int
  serieId       String

  Serie Serie @relation(fields: [serieId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  midiaId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  midia Midia @relation(fields: [midiaId], references: [id], onDelete: Cascade)

  @@unique([userId, midiaId])
}

model WatchLater {
  id        String   @id @default(uuid())
  userId    String
  midiaId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  midia Midia @relation(fields: [midiaId], references: [id], onDelete: Cascade)

  @@unique([userId, midiaId])
}

model Watched {
  id        String   @id @default(uuid())
  userId    String
  midiaId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  midia Midia @relation(fields: [midiaId], references: [id], onDelete: Cascade)

  @@unique([userId, midiaId])
}
